# Copy to .env (never commit .env). All optional: with no keys the agent runs fully offline on mocks.
ANTHROPIC_API_KEY=
COOKSMART_MODEL=claude-sonnet-5-5
COOKSMART_DB=cooksmart.db
# --- Gnani voice (STT Prisma + TTS Timbre). Put your key here, never in chat or git.
# With a key set, the cook's voice notes are transcribed by Gnani and the agent replies with a Gnani voice note.
GNANI_API_KEY=
# auto = use Gnani when a key is set | gnani = require it | mock = never call Gnani
COOKSMART_SPEECH=auto
GNANI_VOICE=Nalini
GNANI_MODEL=timbre-v2.5
# Override only to point at a stand-in server (see: python -m cooksmart.fake_gnani)
# GNANI_STT_URL=https://api.vachana.ai/stt/v3
# GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference

# Used later for the real WhatsApp Cloud API channel
WHATSAPP_VERIFY_TOKEN=cooksmart-dev
